# Base URL of the Oblivion backend (see contract/OPENAPI.yaml `servers`).
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional. The API contract currently defines NO health endpoint. Leave unset and the
# connection indicator reports UNKNOWN until a real request succeeds or fails.
# Set this only once the backend publishes a health route in OPENAPI.yaml.
# VITE_API_HEALTH_PATH=/api/health
