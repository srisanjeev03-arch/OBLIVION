# Oblivion sensitivity-classification evaluation set, v1.
#
# Every target_name here is synthetic. No real filename, path, or user data
# appears in this file, and none should ever be added to it.
#
# Labels are assigned from the NAME ALONE, because that is all the classifier
# is given - contents are never sent to a model. Where a name carries no signal,
# the expected label is UNKNOWN rather than ORDINARY: guessing "ordinary" for an
# unrecognised name is the dangerous failure mode, and cases marked adversarial
# are the ones that bait exactly that.
#
# caveat: This dataset and the deterministic baseline rules were authored together, so a high baseline score measures agreement between two artefacts by the same author, not generalisation to filenames in the field. Treat the baseline's accuracy as a sanity check and an upper bound, never as evidence of real-world performance.
# caveat: Every case is a filename. Nothing here measures whether a classifier can identify sensitive content hiding under an innocuous name, which is the failure mode with the highest real-world consequence and which no name-only method can address.
# caveat: 55 cases is small. Per-class figures for classes with four or five examples move substantially on a single error and should not be quoted as precise.
#
# --- authentication material -------------------------------------------------
{"case_id": "auth-001", "kind": "SENSITIVITY_CLASSIFICATION", "target_name": "id_rsa", "expected_sensitivity": "AUTHENTICATION_MATERIAL", "note": "Canonical OpenSSH private key name."}
{"case_id": "auth-002", "kind": "SENSITIVITY_CLASSIFICATION", "target_name": "server.pem", "expected_sensitivity": "AUTHENTICATION_MATERIAL", "note": "PEM container, conventionally a key or certificate."}
{"case_id": "auth-003", "kind": "SENSITIVITY_CLASSIFICATION", "target_name": "backup_cert.pfx", "expected_sensitivity": "AUTHENTICATION_MATERIAL", "note": "PKCS#12 bundle, normally includes the private key."}
{"case_id": "auth-004", "kind": "SENSITIVITY_CLASSIFICATION", "target_name": "private_key_backup.txt", "expected_sensitivity": "AUTHENTICATION_MATERIAL", "note": "Explicit in the name despite the generic extension."}
{"case_id": "auth-005", "kind": "SENSITIVITY_CLASSIFICATION", "target_name": "prod.keystore", "expected_sensitivity": "AUTHENTICATION_MATERIAL", "note": "Java keystore."}
