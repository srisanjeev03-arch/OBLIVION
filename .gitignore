# ---------------------------------------------------------------------------
# Oblivion monorepo ignores (Python backend + Vite/React frontend)
# ---------------------------------------------------------------------------

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version

# ---- Tooling caches ----
.mypy_cache/
.pytest_cache/
# Scratch area destructive tests erase inside (tests/conftest.py).
.pytest-scratch/
.ruff_cache/
.coverage
.coverage.*
coverage/
htmlcov/

# ---- Runtime state / local data (never commit) ----
*.db
*.db-journal
*.sqlite3
data/
vault/
*.log

# ---- Node / frontend ----
node_modules/
.next/
out/
.vite/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Env / secrets ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Editors / OS ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- Archived material (kept on disk, excluded from tracked source) ----
.archive/
quarantine/

# ---- Per-developer Claude Code settings (machine-local, never shared) ----
.claude/settings.local.json
.claude/worktrees/

# ---- End-to-end harness scratch (disposable, non-system volume) ----
.e2e-scratch/
